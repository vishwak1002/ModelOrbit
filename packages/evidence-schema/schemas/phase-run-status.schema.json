{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://modelorbit.dev/schema/0.2.0/phase-run-status.json", "title": "ModelOrbit phase run status", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "runId", "generatedAt", "deviceManifests", "pocSelection", "counts"],
  "properties": { "schemaVersion": { "const": "0.2.0" }, "runId": { "type": "string" }, "generatedAt": { "type": "string", "format": "date-time" }, "deviceManifests": { "type": "array", "items": { "type": "string" } }, "pocSelection": { "type": "object", "additionalProperties": false, "required": ["status", "candidateIds", "reason"], "properties": { "status": { "enum": ["ready", "verified-empty", "unknown"] }, "candidateIds": { "type": "array", "items": { "type": "string" } }, "reason": { "type": "string" } } }, "counts": { "type": "object", "additionalProperties": false, "required": ["modelsSeen", "iosEligible", "androidEligible", "intersection", "deviceRunsStarted", "deviceRunsPassed"], "properties": { "modelsSeen": { "type": "integer", "minimum": 0 }, "iosEligible": { "type": "integer", "minimum": 0 }, "androidEligible": { "type": "integer", "minimum": 0 }, "intersection": { "type": "integer", "minimum": 0 }, "deviceRunsStarted": { "type": "integer", "minimum": 0 }, "deviceRunsPassed": { "type": "integer", "minimum": 0 } } } }
}
