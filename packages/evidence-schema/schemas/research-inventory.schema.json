{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelorbit.dev/schema/0.2.0/research-inventory.json",
  "title": "ModelOrbit mobile LLM research inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "inventoryId", "searchedAt", "scope", "records", "verifiedIntersection", "intersectionReason"],
  "properties": {
    "schemaVersion": { "const": "0.2.0" },
    "inventoryId": { "type": "string", "pattern": "^research-[a-z0-9-]+$" },
    "searchedAt": { "type": "string", "format": "date-time" },
    "scope": { "type": "object", "additionalProperties": false, "required": ["queryScope", "queries", "inclusionRule", "excludedRule"], "properties": {
      "queryScope": { "type": "string", "minLength": 1 },
      "queries": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
      "inclusionRule": { "type": "string", "minLength": 1 },
      "excludedRule": { "type": "string", "minLength": 1 }
    } },
    "records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/record" } },
    "verifiedIntersection": { "type": "array", "items": { "type": "string", "pattern": "^[^/]+/.+" } },
    "intersectionReason": { "type": "string", "minLength": 1 },
    "modalityReview": { "type": "object", "additionalProperties": false, "required": ["considered", "decision"], "properties": {
      "considered": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
      "decision": { "type": "string", "minLength": 1 }
    } },
    "pocSelection": { "type": "array", "maxItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["rank", "modelId", "revision", "score", "factors"], "properties": {
      "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
      "modelId": { "type": "string", "pattern": "^[^/]+/.+" },
      "revision": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
      "score": { "type": "number", "minimum": 0 },
      "factors": { "type": "object", "additionalProperties": false, "required": ["evidence", "researchValue", "sizeLatency", "runtimeMaturity", "license", "integrationEffort"], "properties": {
        "evidence": { "type": "number", "minimum": 0, "maximum": 5 },
        "researchValue": { "type": "number", "minimum": 0, "maximum": 5 },
        "sizeLatency": { "type": "number", "minimum": 0, "maximum": 5 },
        "runtimeMaturity": { "type": "number", "minimum": 0, "maximum": 5 },
        "license": { "type": "number", "minimum": 0, "maximum": 5 },
        "integrationEffort": { "type": "number", "minimum": 0, "maximum": 5 }
      } }
    } } }
  },
  "$defs": {
    "record": { "type": "object", "additionalProperties": false, "required": ["recordId", "modelId", "canonicalModelId", "disposition", "repositoryUrl", "revision", "license", "architecture", "parameterCount", "quantization", "sourceEvidence", "runtimeSupport", "reason"], "properties": {
      "recordId": { "type": "string", "pattern": "^research-record-[a-z0-9-]+$" },
      "modelId": { "type": "string", "pattern": "^[^/]+/.+" },
      "canonicalModelId": { "type": "string", "pattern": "^[^/]+/.+" },
      "modality": { "type": "string", "minLength": 1 },
      "disposition": { "enum": ["verified", "claimed-but-unverified", "excluded", "deduplicated-variant"] },
      "repositoryUrl": { "type": "string", "format": "uri" },
      "revision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,64}$" },
      "license": { "type": ["string", "null"] },
      "architecture": { "type": ["string", "null"] },
      "parameterCount": { "type": ["integer", "null"], "minimum": 0 },
      "quantization": { "type": ["string", "null"] },
      "sourceEvidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
      "runtimeSupport": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/runtime" } },
      "reason": { "type": "string", "minLength": 1 },
      "notes": { "type": "string" }
    } },
    "source": { "type": "object", "additionalProperties": false, "required": ["sourceId", "url", "sourceType", "authority", "observedAt", "repositoryId", "revision", "claim"], "properties": {
      "sourceId": { "type": "string", "pattern": "^source-[a-z0-9-]+$" },
      "url": { "type": "string", "format": "uri" },
      "sourceType": { "enum": ["hf-model-card", "hf-revision", "official-runtime-doc", "official-runtime-repo", "official-artifact-card", "official-issue"] },
      "authority": { "enum": ["huggingface", "apple", "pytorch", "microsoft", "community"] },
      "observedAt": { "type": "string", "format": "date-time" },
      "repositoryId": { "type": "string", "minLength": 1 },
      "revision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,64}$" },
      "claim": { "type": "string", "minLength": 1 }
    } },
    "runtime": { "type": "object", "additionalProperties": false, "required": ["platform", "runtime", "status", "evidenceSourceIds"], "properties": {
      "platform": { "enum": ["ios", "android"] },
      "runtime": { "enum": ["core-ai", "core-ml", "executorch", "executorch-android", "other"] },
      "status": { "enum": ["verified", "claimed", "unsupported", "unknown"] },
      "evidenceSourceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^source-[a-z0-9-]+$" } },
      "artifactFormat": { "type": ["string", "null"] }
    } }
  }
}
