{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://modelorbit.dev/schema/0.2.0/comparison-route-state.json", "title": "ModelOrbit comparison route state", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "models", "lens", "pipeline"],
  "properties": { "schemaVersion": { "const": "0.2.0" }, "models": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "pattern": "^[^/]+/.+" } }, "lens": { "enum": ["both", "all", "ios", "android"] }, "pipeline": { "type": "string", "minLength": 1 }, "revision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,64}$" } }
}
