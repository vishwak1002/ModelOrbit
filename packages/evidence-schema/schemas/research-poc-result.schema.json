{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelorbit.dev/schema/0.2.0/research-poc-result.json",
  "title": "ModelOrbit research POC result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pocId", "modelId", "modelRevision", "fixtureId", "generatedAt", "ios", "android"],
  "properties": {
    "schemaVersion": { "const": "0.2.0" },
    "pocId": { "type": "string", "pattern": "^poc-[a-z0-9-]+$" },
    "modelId": { "type": "string", "pattern": "^[^/]+/.+" },
    "modelRevision": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "fixtureId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "ios": { "$ref": "#/$defs/lane" },
    "android": { "$ref": "#/$defs/lane" }
  },
  "$defs": { "lane": { "type": "object", "additionalProperties": false, "required": ["runtime", "status", "harnessPath", "reason"], "properties": {
    "runtime": { "enum": ["core-ai", "executorch"] },
    "status": { "enum": ["built", "blocked", "run", "pass", "fail", "unknown"] },
    "harnessPath": { "type": "string", "pattern": "^pocs/.+" },
    "reason": { "type": "string", "minLength": 1 },
    "artifactPath": { "type": ["string", "null"], "pattern": "^(evidence|data)/.+" }
  } } }
}
